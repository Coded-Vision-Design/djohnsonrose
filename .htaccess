RewriteEngine On

# ---- Security headers ----
# The Content-Security-Policy is set per response instead: by index.php for v1,
# which needs a nonce, and by v2/public/.htaccess for v2. HSTS leaves out
# includeSubDomains, as this file also answers for the parent domain's path.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Explicit MIME + access rules for the easter-egg video files in /data/.
# Hostinger's default Apache config returns 403 for unrecognised binary
# extensions in non-root dirs; without these the recycle-bin clip 403s.
<FilesMatch "\.(mp4|m4v|webm|ogv)$">
    Require all granted
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>
AddType video/mp4 .mp4
AddType video/mp4 .m4v
AddType video/webm .webm
AddType video/ogg .ogv
# Hostinger sent the AAC sounds as text/plain.
AddType audio/mp4 .m4a
# llms.txt and llm.txt hold accented names; without a charset browsers guess.
# A header rather than AddCharset, which Hostinger's server ignores.
<IfModule mod_headers.c>
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

# ---- Sensitive files: deny all direct access ----
# .env, dotfiles, config/bootstrap, and any PHP file that isn't an entry point.
# Apache 2.4 "Require all denied" + a few explicit allowlist exceptions for
# the files we DO serve at root.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(config|bootstrap|router|dev-server)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|tsconfig.*\.json|vite\.config\..*|vitest\.config\..*|playwright\.config\..*)$">
    Require all denied
</FilesMatch>

# The site is also reachable at johnson-rose.co.uk/devante/, where deep links
# and cookies behave differently. Send it to the one canonical address, before
# the HTTPS rule so that it takes a single redirect.
RewriteCond %{HTTP_HOST} ^(www\.)?johnson-rose\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://devante.johnson-rose.co.uk/$1 [R=301,L]

# Force HTTPS in production (skip on localhost dev hosts).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Friendly admin URLs - both /admin and /adminconsole resolve to the v2
# React app's deep-link route, which auto-launches the Admin Console.
# Putting these BEFORE the v2 SPA rewrite so they hit the redirect first.
RewriteRule ^admin/?$        /v2/app/admin [R=302,L]
RewriteRule ^adminconsole/?$ /v2/app/admin [R=302,L]

# React v2: serve the SPA from /v2/. Real built files under v2/dist/
# (assets/, index.html, favicon, etc.) are served directly, and so is
# v2/dist/index.html for v2's own addresses below. Any other address under /v2/
# falls through to index.php, which answers with v1's 404 page.
#
# [END] (Apache 2.3.9+) terminates the rewrite engine entirely. Plain [L]
# isn't enough here: in .htaccess context Apache restarts mod_rewrite after
# each match - the second pass would re-match v2/dist/... against the SPA
# fallback and serve index.html for every JS chunk, breaking MIME types.
RewriteCond %{DOCUMENT_ROOT}/v2/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/v2/dist/$1 -d
RewriteRule ^v2/(.+)$ v2/dist/$1 [END]

# A missing hashed file must 404. Falling through to the SPA would answer a
# stale chunk request with index.html and a 200, which fails as a bad script
# instead of a clear load error. Each deploy removes the previous chunks.
RewriteRule ^v2/assets/ - [R=404,L]

# v2's addresses, the same as v1's and as assets/js/windowing/address.js: the
# desktop (also at /login and /desktop) and each app in data/apps.json. A new
# app goes in this list too; v2/src/windowing/address.test.ts checks it.
RewriteRule ^v2(/(login|desktop)?)?/?$ v2/dist/index.html [END]
RewriteRule ^v2/app/(edge|vscode|explorer|terminal|notepad|word|excel|powerpoint|outlook|photoshop|flstudio|docker|putty|filezilla|database|settings|taskmanager|eventviewer|calculator|paint|photos|video|pdfreader|admin|references|github|copilot)/?$ v2/dist/index.html [END]

# v1 (PHP): handle routing to index.php if file/dir doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
